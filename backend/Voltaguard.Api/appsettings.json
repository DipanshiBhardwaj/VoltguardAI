{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Matches the local PostgreSQL container in docker-compose.yml.
    "DefaultConnection": "Host=localhost;Port=5432;Database=voltaguard;Username=voltaguard;Password=voltaguard_dev_pw"
  },
  "Jwt": {
    "Issuer": "Voltaguard.Api",
    "Audience": "Voltaguard.Frontend",
    // DEV-ONLY signing key. Never use this value outside local development;
    // override it with an environment variable or user secret elsewhere.
    "SigningKey": "voltaguard-dev-only-signing-key-change-me-0123456789",
    "ExpiryMinutes": 120
  }
}
